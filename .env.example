# Database: Neon (via Vercel Marketplace) in production; any Postgres URL locally.
DATABASE_URL=postgres://localhost:5432/kola
# Optional: a separate database for `pnpm test` (migrated and seeded with `pnpm test:db`)
TEST_DATABASE_URL=postgres://localhost:5432/kola_test

# Sealed cookie sessions (32+ characters). nuxt-auth-utils >= 0.6 derives the session key from
# Nuxt's appSecret, so this replaces NUXT_SESSION_PASSWORD. Generate: openssl rand -base64 32
NUXT_APP_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# Vercel Blob (product images, CSV imports)
BLOB_READ_WRITE_TOKEN=

# Paystack — GHS cards and mobile money
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Stripe — EUR, GBP, USD
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (console fallback when unset)
RESEND_API_KEY=

# Vercel Cron → /api/cron/* (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=replace-with-random

# Owner admin created by `pnpm db:seed`
ADMIN_SEED_EMAIL=owner@kola.market
ADMIN_SEED_PASSWORD=change-me-please

# Public
NUXT_PUBLIC_STORE_URL=http://localhost:3000
NUXT_PUBLIC_PUBLISHABLE_KEY=
