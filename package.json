{
  "name": "kola-commerce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:reset": "tsx server/db/reset.ts && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@adonisjs/hash": "^9.1.1",
    "@lucide/vue": "^1.77.0",
    "@neondatabase/serverless": "^1.2.1",
    "@nuxt/image": "^2.2.1",
    "@pinia/nuxt": "^1.0.3",
    "@vercel/blob": "^2.9.0",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.2",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "resend": "^6.39.0",
    "stripe": "^23.2.0",
    "ulid": "^3.0.2",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vue/test-utils": "^2.6.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
